    PUSHBUTTON      "Add",IDC_BUTTON_AddManualAccount,237,231,30,14
    LISTBOX         IDC_LIST_logOutput,7,265,408,118,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Log",IDC_STATIC,7,254,58,8
    GROUPBOX        "Settings",IDC_STATIC,234,131,202,40
    EDITTEXT        IDC_EDIT_serverIP,343,139,86,12,ES_AUTOHSCROLL
    RTEXT           "Server IP:",IDC_STATIC,307,141,34,8
