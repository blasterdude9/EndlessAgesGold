    GROUPBOX        "Exercises",IDC_STATIC,231,7,212,255
    PUSHBUTTON      "Logon Stress\n(logs on and off with account list)",IDC_BUTTON_LogonStressTest,234,20,202,25,BS_CENTER | BS_MULTILINE
