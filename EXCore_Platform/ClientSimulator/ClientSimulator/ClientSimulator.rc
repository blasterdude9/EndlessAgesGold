    GROUPBOX        "Account Setup",IDC_STATIC,234,172,202,85
    CONTROL         "Enable Single logon test",IDC_CHECK_EnableSingleLogonTest,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,237,245,92,10
    EDITTEXT        IDC_EDIT_Username,278,186,70,12,ES_AUTOHSCROLL
