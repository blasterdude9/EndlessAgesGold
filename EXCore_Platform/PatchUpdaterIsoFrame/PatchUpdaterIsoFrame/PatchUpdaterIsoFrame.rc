IDD_DIALOG_patchFileUpdate DIALOGEX 0, 0, 263, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Patch System Update(gmContent table)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Done",IDOK,219,132,41,21
    EDITTEXT        IDC_EDIT1,6,141,64,12,ES_AUTOHSCROLL | NOT WS_VISIBLE
    PUSHBUTTON      "Select File To Update",IDC_BUTTON_gmcConetntBrowseFile,73,141,89,12,NOT WS_VISIBLE | WS_DISABLED
    PUSHBUTTON      "Update Database CRC's",IDC_BUTTON_gmcUpdateTable,171,116,89,14
    LTEXT           "",IDC_STATIC_CRC,6,77,201,8
    LTEXT           "",IDC_STATIC_ptcFilePath,6,68,165,8
    EDITTEXT        IDC_EDIT_ContentID,12,45,101,12,ES_AUTOHSCROLL
    LTEXT           "Content id(ussually name of the file)",IDC_STATIC,117,45,117,8
    EDITTEXT        IDC_EDIT_FILENAME,12,7,101,12,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "File Name",IDC_STATIC,139,7,32,8
    EDITTEXT        IDC_EDIT_CABNAME,12,20,101,12,ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "Cab Name",IDC_STATIC,139,20,34,8
    PUSHBUTTON      "B",IDC_BUTTON_BrowseFileName,117,7,16,13
    PUSHBUTTON      "B",IDC_BUTTON_BrowseCabName,117,20,16,13
    LTEXT           "",IDC_STATIC_CRCCAB,6,86,201,8
END

IDD_DIALOG_SQLConnection DIALOGEX 0, 0, 199, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Connection Interface"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Connect",IDOK,131,66,61,14
    PUSHBUTTON      "Abort",IDCANCEL,131,97,61,14
    COMBOBOX        IDC_COMBO_connectionHistory,7,17,135,135,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_cnUsername,19,33,67,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_cnPassword,19,45,67,12,ES_PASSWORD | ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_cnIPAddress,19,57,67,12,ES_AUTOHSCROLL
    LTEXT           "Username",IDC_STATIC,89,33,33,8
    LTEXT           "Password",IDC_STATIC,89,45,32,8
    LTEXT           "Database",IDC_STATIC,89,56,32,8
    LTEXT           "Conection IP address",IDC_STATIC,7,7,75,8
    PUSHBUTTON      "Remove",ID_BTN_RemoveConnection,131,81,61,14
END


