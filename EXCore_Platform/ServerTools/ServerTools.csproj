<Project Sdk="Microsoft.NET.Sdk">
  <!-- ServerTools.exe - the old AXWebServerTools web pages as one Windows app with tabs.
       .NET Framework 4.8 is built into Windows 10/11, so nothing extra to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ServerTools</AssemblyName>
    <RootNamespace>EAServerTools</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon></ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Endless Ages Server Tools</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
