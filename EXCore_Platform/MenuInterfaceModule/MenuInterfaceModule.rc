IDR_MENU_NAV MENU 
BEGIN
    POPUP "Quick"
    BEGIN
        MENUITEM "Play Here (walk around as the picked character)", ID_QUICK_PLAYHERE
        MENUITEM "Back To Editor Camera",       ID_QUICK_BACKTOEDITOR
        MENUITEM SEPARATOR
        MENUITEM "Where Am I (copy X Y Z)",     ID_QUICK_WHEREAMI
        MENUITEM "Go To...",                    ID_QUICK_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Export Character For Blender (glTF)...", ID_QUICK_EXPORTCHARACTER
        MENUITEM "Copy Character As New Entity...", ID_QUICK_COPYENTITY
        MENUITEM "New Race Wizard...", ID_QUICK_NEWRACEWIZARD
        MENUITEM "Export Character + All Outfits (for refit)...", ID_QUICK_EXPORTOUTFITS
        MENUITEM "Import Character From Blender (glTF)...", ID_QUICK_IMPORTCHARACTER
        MENUITEM "Give All Tops Jiggle (picked character)", ID_QUICK_GIVETOPSJIGGLE
        MENUITEM "Give Race The Same Items As... (armor, weapons, jetpacks)", ID_QUICK_COPYITEMRACE
        MENUITEM SEPARATOR
        MENUITEM "Send To Game (Core + EA server)...", ID_QUICK_SENDTOGAME
        MENUITEM "Set Send-To-Game Folders...", ID_QUICK_SETGAMEPATHS
    END
    MENUITEM "World",                       ID_WORLD
    MENUITEM "Characters",                  ID_CHARACTERS
    POPUP "Environment"
    BEGIN
        MENUITEM "Action Zones",                ID_ENVIRONMENT_ACTIONZONES
    END
    POPUP "Gamplay Modules"
    BEGIN
        MENUITEM "Kingdoms Manager",            ID_GAMPLAYMODULES_KINGDOMSMANAGER
    END
    POPUP "Initialization"
    BEGIN
        MENUITEM "Load Script Manager",         ID_INITIALIZATION_LOADSCRIPTMANAGER
        MENUITEM "Scene Script Manager",        ID_INITIALIZATION_SCENESCRIPTMANAGER
    END
    POPUP "Sound"
    BEGIN
        MENUITEM "Music Manager",               ID_SOUND_MUSICMANAGER
    END
    POPUP "Display"
    BEGIN
        MENUITEM "Post Effects",                ID_DISPLAY_POSTEFFECTS
        MENUITEM "Lock View",                   32778
        MENUITEM "Capture Zone Map",            ID_DISPLAY_CAPTUREZONEMAP
        MENUITEM "Capture All Zone Maps",       ID_DISPLAY_CAPTUREALLZONEMAPS
    END
    MENUITEM "Help",                        ID_HELP32775
END


