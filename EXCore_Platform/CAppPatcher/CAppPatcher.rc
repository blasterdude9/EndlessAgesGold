    EDITTEXT        IDC_EDIT_Password,277,100,85,12,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "",IDC_CHECK_Fullscreen,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,305,155,8,8
