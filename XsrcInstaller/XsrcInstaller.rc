IDR_MAINFRAME           ICON                    "res\\XsrcInstaller.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "About XsrcInstaller"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "XsrcInstaller Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2004",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_XSRCINSTALLER_DIALOG DIALOGEX 0, 0, 229, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_APPWINDOW
CAPTION "Endless Ages Install"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Exit",IDOK,188,97,39,14
    LTEXT           "X-src Installer Developed by X-src.com",IDC_STATIC,1,94,
                    128,8,WS_DISABLED
    DEFPUSHBUTTON   "Install",IDC_BUTTON_Install,188,82,39,14
    PUSHBUTTON      "Build Installer",IDC_BUTTON_BuildInstaller,1,59,50,10
    CONTROL         "",IDC_PROGRESS_Install,"msctls_progress32",WS_BORDER,1,
                    103,184,8
    EDITTEXT        IDC_EDIT_installationPath,0,82,131,12,ES_AUTOHSCROLL
    LTEXT           "Install Directory",IDC_STATIC,133,86,52,8,NOT 
                    WS_VISIBLE
    PUSHBUTTON      "Uninstall",IDC_BUTTON_Uninstall,188,82,39,14
    CONTROL         145,IDC_STATIC,"Static",SS_BITMAP,0,0,229,54
    LTEXT           "",IDC_STATUS_Output,0,73,228,8
    LTEXT           "",IDC_STATIC_KBOUT,0,83,106,8,NOT WS_VISIBLE
END

IDD_DIALOG_License DIALOGEX 0, 0, 239, 239
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "License Agreement"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "I agree",IDOK,192,218,40,14
    PUSHBUTTON      "I dont agree",IDCANCEL,141,218,50,14
    EDITTEXT        IDC_EDIT_License,7,7,225,208,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_WANTRETURN
END

IDD_DIALOG_InstallationComplete DIALOGEX 0, 0, 230, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Installation Complete"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,90,85,50,23
    CONTROL         146,IDC_STATIC,"Static",SS_BITMAP,0,0,230,54
END


