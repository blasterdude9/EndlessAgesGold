<?xml version="1.0"?>
<!-- Updated for IIS 10 / .NET Framework 4.8. ASP.NET AJAX (UpdatePanel, ScriptManager)
     is built into .NET 4.x, so the old AJAX 1.0 (System.Web.Extensions 1.0.61025) entries were removed. -->
<configuration>
  <appSettings>
    <!-- Key used by AXencrypt.cs. Must match the key the game servers use, or stored data will not decrypt. -->
    <add key="AXEncryptKey" value="lucidcatscanarbcowlordarronnicol"/>
  </appSettings>
  <connectionStrings>
    <!-- Set these to your SQL Server. Server=localhost works if SQL Server is on this machine. -->
    <add name="GameDB" connectionString="server=tcp:localhost;database=EARevolution;uid=YOUR_SQL_USER;password=YOUR_SQL_PASSWORD;" providerName="System.Data.SqlClient"/>
    <add name="AuthDB" connectionString="server=tcp:localhost;database=EARevolution;uid=YOUR_SQL_USER;password=YOUR_SQL_PASSWORD;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <!-- Keeps the 2008-era HTML output so the old page layouts look the same. -->
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <defaultDocument>
      <files>
        <clear/>
        <add value="SupportAuthentication.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
