<?xml version="1.0"?>
<!-- Added for IIS 10 / .NET Framework 4.8 (this site had no Web.config). -->
<configuration>
  <appSettings>
    <!-- Key used by AXencrypt.cs. Must match the key the game servers use, or stored data will not decrypt. -->
    <add key="AXEncryptKey" value="lucidcatscanarbcowlordarronnicol"/>
  </appSettings>
  <connectionStrings>
    <!-- Set this to your SQL Server. -->
    <add name="GameDB" connectionString="server=tcp:localhost;database=EARevolution;uid=YOUR_SQL_USER;password=YOUR_SQL_PASSWORD;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
</configuration>
