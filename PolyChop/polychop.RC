    LTEXT           "Stan Melax and Bioware",IDC_STATIC,17,198,78,8
    CONTROL         "use edge length",IDC_USEEDGELENGTH,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,10,24,70,10
